{
  "manifest_version": 3,
  "name": "WhatsApp Bulk Sender",
  "version": "1.0",
  "description": "Send bulk messages via WhatsApp.",
  "permissions": ["activeTab"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "",
      "48": "",
      "128": ""
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "",
    "48": "",
    "128": ""
  }
}